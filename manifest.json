{
    "manifest_version": 3,
    "name": "Tab Sorter",
    "version": "1.1",
    "description": "Sort tabs by website domain, subdomain, or semantic similarity",
    "icons": {
        "48": "icons/icon.svg"
    },
    "action": {
        "default_icon": "icons/icon.svg",
        "default_title": "Sort Tabs"
    },
    "background": {
        "scripts": ["dist/background.js"]
    },
    "permissions": [
        "tabs",
        "contextMenus",
        "notifications",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    }
}
